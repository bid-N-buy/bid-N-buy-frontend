{
  "name": "bid-n-buy-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:assets": "aws s3 sync ./dist s3://bid-n-buy-frontend --exclude 'index.html' --cache-control 'public, max-age=31536000, immutable' --delete",
    "deploy:index": "aws s3 cp ./dist/index.html s3://bid-n-buy-frontend/index.html --metadata-directive REPLACE --cache-control 'no-cache, must-revalidate' --content-type 'text/html'",
    "deploy:cf": "aws cloudfront create-invalidation --distribution-id E20IDI1EB3GD0 --paths '/index.html'",
    "deploy": "npm run build && npm run deploy:assets && npm run deploy:index && npm run deploy:cf"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tosspayments/payment-widget-sdk": "^0.12.0",
    "@tosspayments/tosspayments-sdk": "^2.4.0",
    "@tosspayments/widget-sdk-react-native": "^1.5.1",
    "axios": "^1.12.2",
    "firebase": "^12.4.0",
    "lucide-react": "^0.544.0",
    "nanoid": "^5.1.6",
    "react": "^19.1.1",
    "react-datepicker": "^8.8.0",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "sockjs-client": "^1.6.1",
    "tailwindcss": "^4.1.13",
    "websocket-client": "^1.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19.1.9",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.12"
  }
}
